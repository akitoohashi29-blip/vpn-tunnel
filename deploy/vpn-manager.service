[Unit]
Description=VPN Tunnel Manager
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/vpn-manager
Environment=HOME=/root
ExecStart=/opt/vpn-manager/vpn-manager -role={{ROLE}} -port=8080 -iran-ip={{IRAN_IP}} -iran-port={{IRAN_PORT}} -kharej-ip={{KHAREJ_IP}} -kharej-port={{KHAREJ_PORT}} -ssh-user={{SSH_USER}}
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vpn-manager

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/vpn-manager /root/.ssh
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_DAC_OVERRIDE

[Install]
WantedBy=multi-user.target